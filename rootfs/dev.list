# Static device nodes baked into the initramfs, in gen_init_cpio syntax.
#
# The kernel opens /dev/console for PID 1 before /init runs, and the initramfs
# /dev is empty at that point unless these exist.  Without /dev/console PID 1
# starts with fds 0/1/2 closed, the first read hits EOF and the kernel panics
# with "Attempted to kill init".
#
#  name        type  mode uid gid major minor
dir  /dev              0755 0 0
nod  /dev/console  0600 0 0 c 5 1
nod  /dev/null     0666 0 0 c 1 3
nod  /dev/zero     0666 0 0 c 1 5
nod  /dev/tty      0666 0 0 c 5 0
nod  /dev/ttyS0    0600 0 0 c 4 64
nod  /dev/tty0     0600 0 0 c 4 0
