@@ -573,6 +573,45 @@ void e17_smp_disable_snoop(unsigned int cpu)
 /* Inter-processor interrupt: ring + acknowledge.                            */
 /* ------------------------------------------------------------------------- */
 
+/*
+ * Both inter-processor doorbell registers are shared between the CPUs and have
+ * per-CPU (primary vs secondary) bit meanings, so a write from one CPU that
+ * races a write from the other corrupts state (HW manual: cross-CPU CPU2CON
+ * access is unsafe).  The victims:
+ *   - CPU2CON (0xfec58000): CPU0 writes SIPL to ring CPU1; CPU1 writes SICF
+ *     every tick (VIC-clock ack) and to ack the mailbox IPI.
+ *   - VIC ICFSR (0xfec0105f): CPU1 writes the ICMS edge to ring CPU0; CPU0
+ *     read-modify-writes it to ack.
+ * Serialise every runtime access to either with one raw lock.  The critical
+ * sections are a single byte access (or a two-access RMW), and no path holds
+ * the lock while waiting for the other CPU (e17_send_ipi rings and returns; the
+ * caller waits afterwards), so there is no cross-CPU deadlock.  irqsave because
+ * the AP VIC-clock tick (hard IRQ) is one of the writers.
+ */
+DEFINE_RAW_SPINLOCK(e17_smp_reg_lock);
+
+void e17_cpu2con_write(u8 val)
+{
+	unsigned long flags;
+
+	raw_spin_lock_irqsave(&e17_smp_reg_lock, flags);
+	writeb(val, (void __iomem *)E17_CPU2CON);
+	raw_spin_unlock_irqrestore(&e17_smp_reg_lock, flags);
+}
+
+/* Write CPU2CON and read it back atomically (the AP tick's VICIRQ probe). */
+u8 e17_cpu2con_ack_probe(u8 val)
+{
+	unsigned long flags;
+	u8 r;
+
+	raw_spin_lock_irqsave(&e17_smp_reg_lock, flags);
+	writeb(val, (void __iomem *)E17_CPU2CON);
+	r = readb((void __iomem *)E17_CPU2CON);
+	raw_spin_unlock_irqrestore(&e17_smp_reg_lock, flags);
+	return r;
+}
