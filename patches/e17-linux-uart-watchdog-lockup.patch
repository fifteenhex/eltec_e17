+/*
+ * Board watchdog ($FEC5.0000, HW manual 3.8).  Any write pets it; the value is
+ * ignored.  The first write ARMS it, and nothing but a reset can switch it off
+ * again, so petting is a commitment: once anyone has written here, something
+ * must keep writing at least every 1.6 s (jumper J1401) or the board resets.
+ *
+ * u-boot now arms it before handing over - it is the only way back from a
+ * wedged bus, which on this board is otherwise a trip to the power switch - so
+ * the kernel inherits a running watchdog and has no choice but to feed it.
+ * Coverage from the kernel's first instruction to the watchdog driver taking
+ * over comes from, in order: head.S at entry, config_eltec_e17() below, the
+ * 100 Hz tick, and the CD2401 console write.
+ */
+#define E17_WDT		((volatile u8 *)0xfec50000)
+
+void e17_wdt_pet(void)
+{
+	*E17_WDT = 0;
+}
+EXPORT_SYMBOL(e17_wdt_pet);
+
+/*
+ * Reset the board (mach_reset, i.e. reboot/restart).
+ *
+ * There is no software reset register; the board's only reset source we can
+ * provoke is the watchdog, which drives a full SYSRESET.  It is already armed
+ * (u-boot armed it, the kernel keeps it fed), so a reset is just "stop feeding
+ * it".  But the feed is per-CPU - the hard-IRQ petter runs from each CPU's
+ * tick - so CPU0 going quiet is not enough: CPU1 would keep petting and the
+ * board would sit in reboot forever (exactly the hang seen before this
+ * existed).  So hold the secondary in reset first (CPU2CON SRESET=0, the same
+ * write the SMP offline path uses to park it), which stops its tick and its
+ * petting, then drop into a quiet loop with interrupts off.  With nobody
+ * feeding it the watchdog fires within the jumper period (<=1.6 s) and resets
+ * the whole board back through RMON.
+ */
+#define E17_CPU2CON	((volatile u8 *)0xfec58000)	/* bit5 SRESET: 0=hold */
+
+void e17_reset(void)
+{
+	local_irq_disable();
+	*E17_CPU2CON = 0x00;		/* SRESET=0: park the secondary */
+	for (;;)
+		/* starve the watchdog; it resets the board */;
+}
