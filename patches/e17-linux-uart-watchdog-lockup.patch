diff --git a/include/linux/e17_wdt.h b/include/linux/e17_wdt.h
new file mode 100644
index 000000000000..8ed3dd300e65
--- /dev/null
+++ b/include/linux/e17_wdt.h
@@ -0,0 +1,25 @@
+/* SPDX-License-Identifier: GPL-2.0 */
+/*
+ * ELTEC EUROCOM-17 board watchdog, petting side.
+ *
+ * The watchdog at $FEC5.0000 is armed by the first write to it and cannot be
+ * switched off again by software - only a reset stops it.  u-boot arms it
+ * before handing over, because a wedged bus on this board is otherwise
+ * unrecoverable without power-cycling the crate, so the kernel inherits a
+ * running watchdog from its very first instruction and has to keep feeding it.
+ *
+ * The watchdog driver (drivers/watchdog/e17_wdt.c) takes over once it probes.
+ * Until then the feeding is done by head.S at entry, config_eltec_e17(), the
+ * 100 Hz tick and the console write path - so anything that introduces a new
+ * multi-second stretch of early boot needs a call in it too.
+ */
+#ifndef _LINUX_E17_WDT_H
+#define _LINUX_E17_WDT_H
+
+#if IS_ENABLED(CONFIG_ELTEC_E17)
+void e17_wdt_pet(void);
+#else
+static inline void e17_wdt_pet(void) { }
+#endif
+
+#endif /* _LINUX_E17_WDT_H */
