diff --git a/board/eltec/e17/dummy.c b/board/eltec/e17/dummy.c
index f1ecda53c66..5e0a6fe365d 100644
--- a/board/eltec/e17/dummy.c
+++ b/board/eltec/e17/dummy.c
@@ -10,6 +10,11 @@
 #include <linux/string.h>
 #include <asm/bootinfo.h>
 #include <asm/processor.h>
+#include <asm/io.h>
+#include <env.h>
+#include <net.h>
+#include <watchdog.h>
+#include <asm/e17/e17.h>
 
 DECLARE_GLOBAL_DATA_PTR;
 
@@ -65,6 +70,60 @@ void cpu_init_f(void)
 		"cinva   %%bc\n\t"		/* invalidate both caches: drop RMON's stale lines */
 		"nop\n\t"
 		: : : "d0");
+
+	/*
+	 * Silence the UART the monitor was still driving, before anything
+	 * else can touch it.
+	 *
+	 * RMON owns the CD2401 right up to the handover, receiver and
+	 * interrupts enabled.  A character that lands in the gap latches a
+	 * service request nobody acknowledges, and the chip then refuses
+	 * channel commands - so the CCR poll in the serial driver's probe
+	 * never completes and u-boot never reaches a prompt.  That was the
+	 * old "type a key too early and it hangs".
+	 *
+	 * This is the first point where it can be done: the transparent
+	 * translations set up just above are what make the 0xfec00000 I/O
+	 * window reachable at all.
+	 */
+	cd2401_quiesce((void *)E17_SERIAL, (void *)E17_SERIAL_IACK,
+		       (void *)E17_VIC);
+
+	/*
+	 * Arm the watchdog, here at the earliest opportunity, so that from now
+	 * on a wedge recovers by itself.
+	 *
+	 * That matters most for exactly the code above and the serial probe
+	 * that follows: a mis-stepped interrupt acknowledge to the CD2401 gets
+	 * no DTACK, and with no bus-error timeout on this board the 68040
+	 * stalls mid-cycle holding the bus, taking the second CPU with it.
+	 * Nothing short of a reset comes back from that, and until now that
+	 * meant somebody walking over to the crate.
+	 */
+	hw_watchdog_init();
+}
+
+/*
+ * The board watchdog (HW manual 3.8) is a single write-triggered register.
+ * It is disabled until the first write, which arms it; every write after that
+ * pets it; if it goes unpetted for the jumper-selected period (J1401: 100 ms,
+ * or 1.6 s) it pulses reset.  Software cannot turn it off again - only a reset
+ * can - so arming it is a commitment to keep feeding it.
+ *
+ * schedule() calls this for us (CONFIG_HW_WATCHDOG), which covers u-boot's
+ * wait loops - the network stack, the command line, delays.  A path that
+ * neither prints nor calls schedule() for longer than the period will reset a
+ * perfectly healthy board, which is the risk to watch if the jumper turns out
+ * to be on 100 ms rather than 1.6 s.
+ */
+void hw_watchdog_reset(void)
+{
+	writeb(0, (void *)E17_WATCHDOG);
+}
+
+void hw_watchdog_init(void)
+{
+	hw_watchdog_reset();
 }
 
 int dram_init(void)
diff --git a/include/configs/e17.h b/include/configs/e17.h
index fd4836e61a7..0e307f6188f 100644
--- a/include/configs/e17.h
+++ b/include/configs/e17.h
@@ -26,12 +26,66 @@
  * setenv netboot 'dhcp ${loadaddr} ${bootfile}; setenv autostart yes;
  * bootelf -p ${loadaddr}'; run netboot
  */
+/*
+ * Console is serial (CD2401) only.  The onboard video driver is disabled for
+ * now: its DM_VIDEO cyclic full-frame dcache flush hangs the boot on real
+ * hardware (see CONFIG_VIDEO_E17, kept in-tree but off in the defconfig).
+ */
+/*
+ * initramfs is no longer baked into the kernel (CONFIG_INITRAMFS_SOURCE was
+ * dropped).  u-boot now TFTPs three files - the board device tree
+ * (${fdtfile} -> ${fdtaddr}), the initramfs cpio (${initrd_file} ->
+ * ${initrd_start}) and the lz4 kernel (${bootfile} -> ${loadaddr}) - then
+ * writes the initramfs location into the DTB's /chosen node
+ * (linux,initrd-start/-end) with "fdt chosen ${initrd_start} ${initrd_size}"
+ * and boots.  The bootinfo builder (arch/m68k/lib/bootinfo.c) advertises the
+ * loaded DTB via BI_FDT and the ramdisk via BI_RAMDISK (env initrd_start/
+ * initrd_size), so the kernel finds the ramdisk from the device tree.
+ *
+ * RAM map (32 MB board):
+ *   0x0000000-0x0700000  kernel image (bootelf copies LOAD segs to phys 0)
+ *   0x0800000-0x1000000  bootaddr: decompressed ELF, parsed by bootelf (temp)
+ *   0x1000000-0x1800000  loadaddr: compressed lz4 kernel (temp, <=8 MB)
+ *   0x1800000-0x1810000  fdtaddr:  board .dtb (patched in place by fdt resize)
+ *   0x1810000-....       initrd_start: initramfs cpio (grows toward u-boot)
+ * The kernel reserves the DTB and the initramfs so neither is clobbered.
+ * autoload=no keeps "dhcp" from auto-TFTPing the bootfile; we fetch each
+ * file explicitly.
+ */
+/*
+ * No autoboot by default: come up at the prompt and wait.
+ *
+ * Autoboot made every kernel test a race against a three-second countdown on
+ * a 9600-baud link, with the penalty for mistiming a keystroke being a wedged
+ * board and a trip to the power switch.  Landing at the prompt instead costs
+ * one "run netboot" and makes the board reliably drivable.  Put it back for
+ * unattended operation with "setenv bootdelay 2".
+ */
+/*
+ * panic_on_rcu_stall=1 panic=10 in bootargs: reboot a board that has gone
+ * degraded instead of letting it limp.  The hardware watchdog only rescues us
+ * when the tick dies outright; a machine whose timers are half-working keeps
+ * petting it forever while being useless - answering pings, no console input,
+ * no way back in, and no reset.  An RCU stall is the earliest reliable signal
+ * of that state, and rebooting on it restores unattended recovery.
+ */
 #define CFG_EXTRA_ENV_SETTINGS \
+		"bootdelay=-1\0" \
+		"stdin=serial\0" \
+		"stdout=serial\0" \
+		"stderr=serial\0" \
 		"loadaddr=0x1000000\0" \
 		"bootaddr=0x800000\0" \
 		"dstsize=0x800000\0" \
+		"initrd_start=0x1810000\0" \
 		"serverip=192.168.2.1\0" \
-		"bootfile=vmlinux.e17.stripped.lz4\0" \
-		"bootargs=console=ttyS0 ip=dhcp\0" \
-		"netboot=dhcp ${loadaddr} ${bootfile}; crc32 ${loadaddr} ${filesize}; unlz4 ${loadaddr} ${bootaddr} ${dstsize}; setenv autostart yes; bootelf -p ${bootaddr}\0" \
+		"autoload=no\0" \
+		"bootfile=e17/vmlinux.e17.stripped.lz4\0" \
+		"initrd_file=e17-rootfs.cpio\0" \
+		"bootargs=console=tty0 console=ttyS0 ip=dhcp e17_idle=spin panic=10 -- smolinit.telnetd=23 smolinit.securetty=/dev/ttyS0\0" \
+		"nfetch=dhcp; " \
+			"tftp ${loadaddr} ${bootfile}; crc32 ${loadaddr} ${filesize}\0" \
+		"nprep=unlz4 ${loadaddr} ${bootaddr} ${dstsize}\0" \
+		"netboot=run nfetch; run nprep; setenv autostart yes; " \
+			"bootelf -p ${bootaddr}\0" \
 		"bootcmd=run netboot\0"
