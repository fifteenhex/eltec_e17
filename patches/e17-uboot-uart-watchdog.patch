diff --git a/arch/m68k/Kconfig b/arch/m68k/Kconfig
index a8cc69c8faf..fcadf08d135 100644
--- a/arch/m68k/Kconfig
+++ b/arch/m68k/Kconfig
@@ -309,6 +309,13 @@ config TARGET_E17
 	select WDT
 	select WDT_MMIO
 
+	# Arm the board watchdog from cpu_init_f, long before the driver model
+	# is up, and let schedule() pet it.  The fragile code - the CD2401
+	# interrupt-acknowledge handshake - runs during early init, and a
+	# mis-stepped acknowledge there stalls the bus with no way back except
+	# a reset, so the safety net has to be in place before then.
+	select HW_WATCHDOG
+
 	# For populating the DT with the bootinfo data
 	select OF_BOARD_FIXUP
 	select SPL

diff --git a/common/board_r.c b/common/board_r.c
