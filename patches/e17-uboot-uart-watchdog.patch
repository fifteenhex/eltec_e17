index dde1688c7f3..4490a03b51e 100644
--- a/include/cd2401.h
+++ b/include/cd2401.h
@@ -19,22 +19,56 @@
 #define CD2401_REOIR_NOTRANS BIT(3)
 #define CD2401_TEOIR		0x85
 #define CD2401_TEOIR_NOTRANS BIT(3)
+#define CD2401_MEOIR		0x86
+#define CD2401_MEOIR_NOTRANS BIT(3)
 #define CD2401_RISRH		0x88
 #define CD2401_RISRL		0x89
 #define CD2401_TISR			0x8a
 #define CD2401_TISR_TXEMPTY BIT(1)
 #define CD2401_TPILR		0xe0
 #define CD2401_RPILR		0xe1
+#define CD2401_MPILR		0xe3
 #define CD2401_TIR			0xec
 #define CD2401_TIR_TACT		BIT(6)
 #define CD2401_RIR			0xed
 #define CD2401_RIR_RACT		BIT(6)
 #define CD2401_RIR_REN		BIT(7)
+#define CD2401_MIR			0xef
+#define CD2401_MIR_MACT		BIT(6)
+#define CD2401_MIR_MEN		BIT(7)
 #define CD2401_CAR			0xee
 #define CD2401_TDR			0xf8
 #define CD2401_RDR			CD2401_TDR
 
 #define CD2401_FIFO_SZ		16
+#define CD2401_NR_CHANNELS	4
+
+/*
+ * Shared service window.
+ *
+ * The chip answers a software interrupt acknowledge only when one of its three
+ * priority registers matches the level carried in the acknowledge address, and
+ * only for the request its own internal priority (rx > tx > modem) currently
+ * favours.  Giving transmit and receive *different* levels therefore looks
+ * reasonable and is a trap: with a character waiting, receive wins, so an
+ * acknowledge at the transmit level matches nothing and goes un-DTACKed - and
+ * this board has no bus-error timeout, so the 68040 stalls mid-cycle holding
+ * the bus and takes the second CPU with it.  That is the "type a word at the
+ * prompt and the board dies" failure.
+ *
+ * So all three levels are programmed alike (0xfb, as RMON and Linux both use;
+ * the compare is 7 bits, hence acknowledge address 0x7b) and callers dispatch
+ * on the vector type they get back rather than the one they wanted.
+ *
+ * Note there is deliberately no "is a request pending" test here.  RIR/TIR/MIR
+ * bit 6 reports an already-active service context, but no bit of theirs is a
+ * usable pending flag - TIR has none at all - so the only sound precondition
+ * for an acknowledge is the interrupt line itself, via LICR6.STATE.
+ */
+#define CD2401_SVC_PILR		0xfb
+#define CD2401_SVC_IPL		(CD2401_SVC_PILR & 0x7f)
+
+#define CD2401_IR_ACTIVE	BIT(6)
 
 #define CD2401_VECTOR_TYPE_MASK		0x3
 #define CD2401_VECTOR_TYPE_RXEXCP	0b00
@@ -43,6 +77,8 @@
 #define CD2401_VECTOR_TYPE_RXD		0b11
 
 #ifndef __ASSEMBLY__
+#include <vic068a.h>
+
 static inline unsigned int cd2401_interrupting_port(void *base)
 {
 	return (readb(base + CD2401_LICR) >> 2) & 0x3;
@@ -52,6 +88,116 @@ static inline unsigned int cd2401_vector_type(u8 vector)
 {
 	return (vector & CD2401_VECTOR_TYPE_MASK);
 }
+
+static inline void cd2401_set_shared_pilr(void *base)
+{
+	writeb(CD2401_SVC_PILR, base + CD2401_TPILR);
+	writeb(CD2401_SVC_PILR, base + CD2401_RPILR);
+	writeb(CD2401_SVC_PILR, base + CD2401_MPILR);
+}
+
+/*
+ * Is the chip asserting its interrupt?  LICR.STATE is the raw pin and active
+ * low.  This is the only safe precondition for an acknowledge - but it is not
+ * a perfect one: LIRQ6 is the self-vectored daisy chain shared with the system
+ * and user CIOs, so it can be low for something that is not this UART.  The
+ * chip answering is what keeps the cycle alive, so keep the two CIOs quiet.
+ */
+static inline int cd2401_asserting(void *vic)
+{
+	return !vic_lirq_state(vic, VIC_LICR6);
+}
+
+static inline int cd2401_wait_asserting(void *vic, unsigned int loops)
+{
+	while (loops--) {
+		if (cd2401_asserting(vic))
+			return 1;
+	}
+
+	return 0;
+}
+
+/*
+ * Finish a receive service: read the status, empty the fifo, end the
+ * interrupt.  The status read is not optional - a fifo overrun arrives as a
+ * receive *exception* which latches until RISR is read, and an unread
+ * exception re-asserts the interrupt for ever.
+ */
+static inline void cd2401_finish_rx(void *base, u8 *buf, unsigned int max,
+				    unsigned int *len)
+{
+	unsigned int n, i;
+
+	(void)readb(base + CD2401_RISRH);
+	(void)readb(base + CD2401_RISRL);
+
+	n = readb(base + CD2401_RFOC);
+	if (n > CD2401_FIFO_SZ)
+		n = CD2401_FIFO_SZ;
+
+	for (i = 0; i < n; i++) {
+		u8 ch = readb(base + CD2401_RDR);
+
+		if (buf && len && *len < max)
+			buf[(*len)++] = ch;
+	}
+
+	writeb(0, base + CD2401_REOIR);
+}
+
+/*
+ * Put the chip back into its background context, whatever state the previous
+ * owner left it in, and silence every channel.
+ *
+ * This matters at takeover.  The monitor ROM drives this UART right up to the
+ * moment it hands over, with the receiver and its interrupts enabled, so a
+ * character arriving during the handover latches a service request that the
+ * new owner never acknowledges: the chip asserts its interrupt line and waits.
+ * While a request is outstanding it will not accept a channel command either,
+ * so the CCR poll in serial_cd2401_probe() spins forever - which is why
+ * pressing a key too early used to stop u-boot from ever coming up.
+ *
+ * Unwinding it has to be done in the chip's own terms, one service type at a
+ * time, because RDR may only be touched inside the receive context and a
+ * latched receive exception re-asserts the interrupt until RISR is read.  A
+ * few passes, since another character can land while we work.
+ */
+static inline void cd2401_quiesce(void *base, void *iack, void *vic)
+{
+	int pass, i;
+
+	cd2401_set_shared_pilr(base);
+
+	for (pass = 0; pass < 16; pass++) {
+		u8 ack;
+
+		if (!cd2401_asserting(vic))
+			break;
+
+		ack = readb(iack + CD2401_SVC_IPL);
+
+		switch (ack & CD2401_VECTOR_TYPE_MASK) {
+		case CD2401_VECTOR_TYPE_RXD:
+		case CD2401_VECTOR_TYPE_RXEXCP:
+			cd2401_finish_rx(base, NULL, 0, NULL);
+			break;
+		case CD2401_VECTOR_TYPE_TXD:
+			/* NOTRANS, so nothing is sent on the way out. */
+			writeb(CD2401_TEOIR_NOTRANS, base + CD2401_TEOIR);
+			break;
+		default:
+			writeb(CD2401_MEOIR_NOTRANS, base + CD2401_MEOIR);
+			break;
+		}
+	}
+
+	/* Nothing is in service now, so the per-channel banking is ours. */
+	for (i = 0; i < CD2401_NR_CHANNELS; i++) {
+		writeb(i, base + CD2401_CAR);
+		writeb(0, base + CD2401_IER);
+	}
+}
 #endif
 
 #endif

diff --git a/include/watchdog.h b/include/watchdog.h
index 0149b44d077..2d6c540935c 100644
--- a/include/watchdog.h
+++ b/include/watchdog.h
@@ -38,6 +38,12 @@ int init_func_watchdog_reset(void);
 
 #if defined(CONFIG_HW_WATCHDOG) || defined(CONFIG_WATCHDOG)
 	void hw_watchdog_init(void);
+	/*
+	 * Pet the hardware directly.  Prefer schedule(), which calls this for
+	 * you - but code that schedule() can re-enter (the console driver, say)
+	 * has to come straight here.
+	 */
+	void hw_watchdog_reset(void);
 #endif
 
