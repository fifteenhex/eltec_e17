diff --git a/board/eltec/e17/dummy.c b/board/eltec/e17/dummy.c
index f1ecda5..02ec96d 100644
--- a/board/eltec/e17/dummy.c
+++ b/board/eltec/e17/dummy.c
@@ -10,6 +10,8 @@
 #include <linux/string.h>
 #include <asm/bootinfo.h>
 #include <asm/processor.h>
+#include <asm/io.h>
+#include <asm/e17/e17.h>
 
 DECLARE_GLOBAL_DATA_PTR;
 
@@ -65,6 +67,23 @@ void cpu_init_f(void)
 		"cinva   %%bc\n\t"		/* invalidate both caches: drop RMON's stale lines */
 		"nop\n\t"
 		: : : "d0");
+
+	/*
+	 * Silence the UART the monitor was still driving, before anything
+	 * else can touch it.
+	 *
+	 * RMON owns the CD2401 right up to the handover, receiver and
+	 * interrupts enabled.  A character that lands in the gap latches a
+	 * service request nobody acknowledges, and the chip then refuses
+	 * channel commands - so the CCR poll in the serial driver's probe
+	 * never completes and u-boot never reaches a prompt.  That was the
+	 * old "type a key too early and it hangs".
+	 *
+	 * This is the first point where it can be done: the transparent
+	 * translations set up just above are what make the 0xfec00000 I/O
+	 * window reachable at all.
+	 */
+	cd2401_quiesce((void *)E17_SERIAL, (void *)E17_SERIAL_IACK);
 }
 
 int dram_init(void)
