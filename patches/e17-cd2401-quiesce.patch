diff --git a/include/cd2401.h b/include/cd2401.h
index dde1688..8e3bad2 100644
--- a/include/cd2401.h
+++ b/include/cd2401.h
@@ -19,22 +19,36 @@
 #define CD2401_REOIR_NOTRANS BIT(3)
 #define CD2401_TEOIR		0x85
 #define CD2401_TEOIR_NOTRANS BIT(3)
+#define CD2401_MEOIR		0x86
+#define CD2401_MEOIR_NOTRANS BIT(3)
 #define CD2401_RISRH		0x88
 #define CD2401_RISRL		0x89
 #define CD2401_TISR			0x8a
 #define CD2401_TISR_TXEMPTY BIT(1)
 #define CD2401_TPILR		0xe0
 #define CD2401_RPILR		0xe1
+#define CD2401_MPILR		0xe3
 #define CD2401_TIR			0xec
 #define CD2401_TIR_TACT		BIT(6)
 #define CD2401_RIR			0xed
 #define CD2401_RIR_RACT		BIT(6)
 #define CD2401_RIR_REN		BIT(7)
+#define CD2401_MIR			0xef
+#define CD2401_MIR_MACT		BIT(6)
+#define CD2401_MIR_MEN		BIT(7)
 #define CD2401_CAR			0xee
 #define CD2401_TDR			0xf8
 #define CD2401_RDR			CD2401_TDR
 
 #define CD2401_FIFO_SZ		16
+#define CD2401_NR_CHANNELS	4
+
+/*
+ * Every one of the three interrupt registers (RIR/TIR/MIR) reports a pending
+ * request in bit 7 and an in-progress service in bit 6.
+ */
+#define CD2401_IR_PENDING	BIT(7)
+#define CD2401_IR_ACTIVE	BIT(6)
 
 #define CD2401_VECTOR_TYPE_MASK		0x3
 #define CD2401_VECTOR_TYPE_RXEXCP	0b00
@@ -52,6 +66,97 @@ static inline unsigned int cd2401_vector_type(u8 vector)
 {
 	return (vector & CD2401_VECTOR_TYPE_MASK);
 }
+
+/*
+ * Enter the service context for one interrupt type, if there is anything to
+ * service.  Returns 1 when the chip is in that context and the caller must
+ * finish with the matching End Of Interrupt.
+ *
+ * `ir` is RIR/TIR/MIR and `pilr` the matching priority-interrupt-level
+ * register.  A request that is merely pending has to be acknowledged before
+ * the context is entered, which on this board is a read of the software-IACK
+ * window at the level the PILR currently holds.  We only ever do that read
+ * when bit 7 says a request really is outstanding: a bus cycle nobody answers
+ * hangs the board hard, so blind acknowledges are not an option.
+ */
+static inline int cd2401_enter_service(void *base, void *iack, u8 ir, u8 pilr)
+{
+	u8 v = readb(base + ir);
+	u8 ipl;
+
+	if (!(v & (CD2401_IR_PENDING | CD2401_IR_ACTIVE)))
+		return 0;
+	if (v & CD2401_IR_ACTIVE)
+		return 1;
+
+	ipl = readb(base + pilr);
+	if (!ipl)
+		return 0;		/* level 0: no way in, leave it alone */
+
+	(void)readb(iack + ipl);
+
+	return !!(readb(base + ir) & CD2401_IR_ACTIVE);
+}
+
+/*
+ * Put the chip back into its background context, whatever state the previous
+ * owner left it in, and silence every channel.
+ *
+ * This matters at takeover.  The monitor ROM drives this UART right up to the
+ * moment it hands over, with the receiver and its interrupts enabled, so a
+ * character arriving during the handover latches a service request that the
+ * new owner never acknowledges: the chip asserts its interrupt line and waits.
+ * While a request is outstanding it will not accept a channel command either,
+ * so the CCR poll in serial_cd2401_probe() spins forever - which is why
+ * pressing a key too early used to stop u-boot from ever coming up.
+ *
+ * Unwinding it has to be done in the chip's own terms, one service type at a
+ * time, because RDR may only be touched inside the receive context and a
+ * latched receive exception re-asserts the interrupt until RISR is read.  A
+ * few passes, since another character can land while we work.
+ */
+static inline void cd2401_quiesce(void *base, void *iack)
+{
+	int pass, i;
+
+	for (pass = 0; pass < 4; pass++) {
+		int busy = 0;
+
+		/* Modem: nothing to collect, just leave the context. */
+		if (cd2401_enter_service(base, iack, CD2401_MIR, CD2401_MPILR)) {
+			writeb(CD2401_MEOIR_NOTRANS, base + CD2401_MEOIR);
+			busy = 1;
+		}
+
+		/* Transmit: NOTRANS, so the chip sends nothing on our way out. */
+		if (cd2401_enter_service(base, iack, CD2401_TIR, CD2401_TPILR)) {
+			writeb(CD2401_TEOIR_NOTRANS, base + CD2401_TEOIR);
+			busy = 1;
+		}
+
+		/* Receive: clear the latched status, then discard the FIFO. */
+		if (cd2401_enter_service(base, iack, CD2401_RIR, CD2401_RPILR)) {
+			unsigned int n;
+
+			(void)readb(base + CD2401_RISRH);
+			(void)readb(base + CD2401_RISRL);
+			n = readb(base + CD2401_RFOC);
+			for (i = 0; i < (int)n && i < CD2401_FIFO_SZ; i++)
+				(void)readb(base + CD2401_RDR);
+			writeb(0, base + CD2401_REOIR);
+			busy = 1;
+		}
+
+		if (!busy)
+			break;
+	}
+
+	/* Nothing is in service now, so the per-channel banking is ours. */
+	for (i = 0; i < CD2401_NR_CHANNELS; i++) {
+		writeb(i, base + CD2401_CAR);
+		writeb(0, base + CD2401_IER);
+	}
+}
 #endif
 
 #endif
